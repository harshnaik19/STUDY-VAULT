# =====================================================================
# StudyVault Environment Configuration (.env)
# Copy this file to '.env' and fill in your OAuth credentials.
# =====================================================================

# Flask Session Secret Key
SECRET_KEY=studyvault_super_secret_key_change_in_production_2026

# =====================================================================
# Google OAuth 2.0 Credentials
# Setup Guide:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project -> APIs & Services -> Credentials
# 3. Create Credentials -> OAuth client ID -> Web application
# 4. Add Authorized Redirect URI: http://127.0.0.1:5000/auth/google/callback
# 5. Copy Client ID and Client Secret below:
# =====================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# =====================================================================
# GitHub OAuth Credentials
# Setup Guide:
# 1. Go to GitHub Developer Settings: https://github.com/settings/developers
# 2. Click 'New OAuth App'
# 3. Application Name: StudyVault
# 4. Homepage URL: http://127.0.0.1:5000/
# 5. Authorization callback URL: http://127.0.0.1:5000/auth/github/callback
# 6. Click 'Register application' and generate a Client Secret
# 7. Copy Client ID and Client Secret below:
# =====================================================================
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
